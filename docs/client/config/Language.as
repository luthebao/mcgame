            EQUIPTFUNCPANEL_S[72] = "Hướng dẫn:\n1.Đổi thuộc tính linh hồn có thể làm tái lập thuộc tính khóa linh hồn của trang bị, nhưng cần 1 lượng Linh Hồn Thạch tương ứng.Trang bị  <font color='#FF00FF'>tím</font> trác việt trở lên có linh hồn đều có thể tiến hành đổi.\n2.Đổi thuộc tính linh hồn có 2 cách: Đổi hoàn toàn - Mỗi lần đổi sẽ tốn 1 Linh Hồn Thạch và 50000 bạc hoặc ngân phiếu, sau khi đổi thì thuộc tính khóa và các số liệu liên quan sẽ được làm mới lại ngẫu nhiên, dựa vào kết quả có thể chọn ứng dụng kết quả này hoặc hủy bỏ;Đổi một phần – Mỗi lần đổi sẽ tốn gấp 2 lần so với đổi hoàn toàn, vẫn giữ nguyên loại của thuộc tính khóa, chỉ đổi các số liệu tương ứng. Nếu kết quả sau khi đổi thấp hơn trước đó thì số thuộc tính linh hồn sẽ không đổi";
            EQUIPTFUNCPANEL_S[73] = "Hướng dẫn:\n1.Trang bị đã khóa phẩm chất <font color='#FF00FF'>tím</font> trở lên sau khi trả một lượng nguyên liệu và tiền vàng sẽ có thể đổi chất lượng nhưng vẫn giữ được cấp độ.\n2.Khi dùng nguyên liệu cấp 5 để đổi chất lượng: sẽ nhận được trang bị trác việt <font color='#FF00FF'>tím</font> (nếu trang bị đem đi đổi là <font color='#FA5B05'>cam</font> thì sẽ vẫn giữ được màu <font color='#FA5B05'>cam</font> và chất lượng),Các thuộc tính nguyên tố và khóa linh hồn sẽ được đổi ngẫu nhiên, trang bị sẽ bị hạ 1 cấp sao. Bảo thạch và số lỗ giữ nguyên.\n3.Khi dùng nguyên liệu cấp 6 để đổi chất lượng: Chắc chắn sẽ nhận được trang bị <font color='#FA5B05'>cam</font>(nếu trang bị đem đi đổi là trác việt <font color='#FA5B05'>cam</font> thì sẽ vẫn giữ được màu <font color='#FA5B05'>cam</font> và chất lượng trác việt, nếu trang bị đem đi đổi là màu <font color='#FA5B05'>cam</font> nhưng không  phải trác việt thì chất lượng trang bị sẽ được đổi ngẫu nhiên), thuộc tính nguyên tố và khóa linh hồn sẽ được đổi ngẫu nhiên, cấp sao không giảm, bảo thạch và số lỗ giữ nguyên.  ";
            EQUIPTFUNCPANEL_S[74] = "Thay đổi chất lượng thành công!";
            EQUIPTFUNCPANEL_S[75] = "Phẩm chất trang bị của bạn đã là tối đa!";
