            ASTROLOGIC_PANEL_U[39] = "Thu thập nguyên tố theo công thức thứ tự sẽ nhận thưởng, cứ 12h trưa mỗi ngày sẽ làm mới công thức";
            ASTROLOGIC_PANEL_U[40] = "Hoàn thành c.thức bất kỳ đầu tiên sẽ x10 ph.thưởng!";
            ASTROLOGIC_PANEL_U[41] = "Thu thập Ng.Tố 5 thì Ng.Tố 1 sẽ tự mất";
            ASTROLOGIC_PANEL_U[42] = (((("1、Người chơi cấp 70 có thể mở bảng Năng Lượng Tự Nhiên.\n" + "2、Khi các nguyên tố sáng lên, người chơi có thể chọn lấy 1 nguyên tố để thu thập sao cho phải đúng với công thức tổ hợp nguyên tố hiển thị ở khung bên phải (Mỗi lần thu thập cố định nhận được 1 lượng Năng Lượng Tự Nhiên). Khi nguyên tố thu thập được khớp với công thức tổ hợp nguyên tố thì nguyên tố thu thập được sẽ tự biến mất, đồng thời người chơi sẽ nhận được phần thưởng tương ứng. Lần đầu hoàn thành sẽ nhận được x10 phần thưởng, sau đó công thức nguyên tố tiếp theo cũng sẽ được mở. Những công thức tổ hợp nguyên tố nào đã công khai, chỉ cần thu thập nguyên tố trùng khớp với công thức này, người chơi sẽ nhận được phần thưởng tương ứng. Số lần tham gia mỗi ngày không giới hạn.\n") + "3、Mỗi lần thu thập xong, 3 nguyên tố khác sẽ tự sáng đèn ngẫu nhiên. Nếu trong số đó kh6ng có nguyên tố muốn chọn, người chơi có thể nhấn chọn Làm Mới để xuất hiện 3 nguyên tố ngẫu nhiên khác.\n") + "4、12h trưa mỗi ngày sẽ làm mới công thức nguyên tố. Công thức sau khi được làm mới sẽ không hiển thị (có thể dùng Vàng để Nhìn Trộm), đồng thời số nguyên tố thu thập được cũng mất, số lần làm mới và thu thập được hồi phục. Tuy nhiên 3 Nguyên Tố sáng đèn không được làm mới.\n") + "5、Cứ mỗi chu kỳ (tính từ 12h trưa hôm nay đến 12h trưa ngày mai) sẽ có 10 lượt làm mới và 12 lượt thu thập miễn phí. Muốn có thêm lượt phải sử dụng vàng để mua. Số lần mua không giới hạn.");
