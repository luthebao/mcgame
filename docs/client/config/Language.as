            LOTTO_PANEL_U[16] = "Tương truyền ở Anh Vũ Cảnh có 1 Cây Ước Nguyện thần kỳ, đã mấy ngàn năm nay không hề héo úa. Nghe nói trong thân cây có 1 thần rừng vĩ đại đang trú ngụ, có thể hiểu thấu lòng người! Chỉ cần đứng dưới gốc cây khấn nguyện điều ước của mình là có thể khiến cho thần rừng cảm động, biến điều ước trở thành sự thực. Tất nhiên là bạn phải thành tâm khấn nguyện!";
            LOTTO_PANEL_U[17] = "Nghe nói vào những đêm thanh tịnh, gốc Cây Ước Nguyện ở Anh Vũ Cảnh lại phát ra ánh sáng lấp lánh. Đây chính là lúc thần rừng trú ngụ trong gốc cây đang lắng nghe âm thanh vạn vật. Lúc này, chỉ cần đến dưới gốc cây thắp lên 1 ngọn nến, sau đó khấn nguyện điều ước của mình thì thần rừng sẽ thi triển pháp thuật, biến điều ước đó của bạn thành sự thực.";
            LOTTO_PANEL_U[18] = "Mọi người thường bảo được tặng 1000 con hạc giấy tức là được nhận lời chúc từ người tặng. Nếu đến dưới gốc Cây Ước Nguyện và treo lên 1000 con hạc giấy thì sẽ khiến cho thần rừng trú ngụ trong gốc cây cảm động. Hãy đến treo hạc hàng ngày, biết đâu đến một lúc nào đó, thần rừng sẽ ban thưởng cho bạn bằng 1 điều ước.";
            LOTTO_PANEL_U[19] = "Muốn nhìn thấy sao băng không phải là việc đơn giản. Nếu đang đứng dưới gốc Cây Ước Nguyện ở Anh Vũ Cảnh mà lại nhìn thấy sao băng thì chính là một dịp may hiếm có! Nếu đúng lúc này nói lên điều ước của mình, thì chắc chắn điều đó sẽ trở thành hiện thực!";
