            NINE_BOSS[23] = "Quỷ Vương được xem là sứ giả địa ngục hung ác. Hắn ta luôn muốn đem đến khổ ải sinh lão bệnh tử vào thế giới Vô Ưu này.";
            NINE_BOSS[24] = "Chu Ma Vương đích thân xung trận, nhưng hắn cần phải triệu hồi hồn ma khắp nơi về để gia tăng sức mạnh. Các dũng sĩ hãy nắm bắt cơ hội này mà tiêu diệt hắn!";
            NINE_BOSS[25] = "Trước sĩ khí của lòng quân Đại Lục Vô Ưu, Chu Ma Vương đã tạm nhượng bộ, nhưng bên ngoài hắn vẫn âm mưu bày binh bố trận, gãy bẫy mọi người. Các dũng sĩ phải hết sức cẩn thận!";
            NINE_BOSS[26] = "Tuy đã dần đánh bại Chu Ma Vương nhưng vẫn chưa ngăn được tiếng quân hùng hổ của vô số yêu ma mà Chu Ma Vương triệu hồi về! Các dũng sĩ hãy tiếp tục chiến đấu!";
            NINE_BOSS[27] = "Hydra sinh ra từ dung nham của địa ngục, cho nên sức mạnh của hắn rất được Chu Ma Vương xem trọng. Các dũng sĩ quyết tâm, không chùn bước trước hiểm nguy!";
            NINE_BOSS[28] = "Atula là 1 trong những hung thần trong lục đạo, ai nghe danh cũng phải khiếp sợ. Các dũng sĩ hãy cố lên vì 1 hòa bình cho Đại Lục Vô Ưu.";
