            EQUIPTFUNCPANEL_S[78] = "Thăng cấp thần khí thành công lên cấp {level}!";
            EQUIPTFUNCPANEL_S[79] = "Vui lòng chọn kỹ năng thần khí cần thiết lập lại!";
