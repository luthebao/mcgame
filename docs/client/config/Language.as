            EQUIPTFUNCPANEL_S[86] = "Tái thiết lập kỹ năng thần khí thành công, nhận được kỹ năng: {skillName}";
            EQUIPTFUNCPANEL_S[87] = "Hướng dẫn:\n1.<font color='#FF0000'>Thăng Tinh Thạch</font>có tác dụng thăng sao cho trang bị Pet, Sao trang bị Pet càng cao thuộc tính càng cao.\n2.Mỗi lần thăng sao, số nguyên liệu cơ bản đặt vào không giống nhau và tỉ lệ thành công cũng khác nhau.\n3.Tỉ lệ thăng sao thành công tùy thuộc vào số sao hiện tại.\n4.Thiết lập xong “Nguyên liệu cơ bản” và “Số sao cao nhất muốn thăng”, bạn chỉ cần đặt đủ số Thăng Tinh Thạch vào và nhấp “Tự động thăng tinh” để thăng sao cho trang bị pet của mình.";
            EQUIPTFUNCPANEL_S[88] = "Hướng dẫn:\n1.Chỉ có<font color='#FF0000'>trang bị Pet khóa</font>mới được thăng cấp. Số sao và màu trước đó sẽ được lưu lại.\n2.Các trang bị pet cấp thấp chỉ cần tốn 1 lượng<font color='#FF0000'> Mảnh Vỡ Linh Giáp </font><font color='#00FF00'>(vật phẩm có bán trong shop)</font>và 1 lượng bạc thì có thể thăng cấp thành công trang bị.";
            EQUIPTFUNCPANEL_S[89] = "Hướng dẫn:\n1.Thăng cấp thuộc tính màu của trang bị pet có thể tăng thuộc tính dung hợp trang bị pet. Trang bị có màu xanh dương trở lên sẽ kích hoạch được bộ thuộc tính. \n2.Nhờ vào<font color='#FF0000'> Tinh Túy Linh Giáp</font><font color='#00FF00'>(vật phẩm có bán trong shop)</font>có thể thăng cấp phẩm chất màu của trang bị trắng, xanh lục, xanh dương.<font color='#FF0000'> Tinh Hồn Linh Giáp </font><font color='#00FF00'>(vật phẩm sự kiện)</font> có thể thăng cấp phẩm chất màu của trang bị lên cam. \n3.Chỉ có trang bị pet khóa mới đổi thuộc tính màu trang bị được. \n4.Nếu đổi màu thất bại,<font color='#FF0000'> Tinh Túy Linh Giáp </font>hoặc<font color='#FF0000'> Tinh Hồn Linh Giáp </font>sẽ biến mất. Trang bị gốc không bị tổn thất. ";
            EQUIPTFUNCPANEL_S[90] = 'Hướng dẫn:\n1.Thăng cấp thần khí chính cần tốn 1 lượng"thần tu"điểm,"thần tu" nhận được qua nhiệm vụ hàng ngày và sự kiện.\n2.Chỉ có thần khí chính khóa mới đươc thăng cấp, thần khí phụ không được thăng cấp. Sau khi thăng cấp thuộc tính của thần khí chính sẽ tăng cường. Kỹ năng thần khí có thể tiếp tục thăng cấp. Khi đạt đến cấp độ nhất định, thuộc tính màu cũng sẽ thay đổi. Thần khí thăng đến cấp 16 trở lên cần nhân vật có cấp độ 100.';
            EQUIPTFUNCPANEL_S[91] = 'Hướng dẫn:\n1.Tất cả thần khí đều có thể phân giải, khi giải cần có pass kho.\n2.Sau khi phân giải thần khí chính sẽ nhận lại 40% điểm thần tu, đồng thời nhận 1 Thâm Lam Tinh hoặc Thâm Hồng Tinh; sau khi phân giải thần khí phụ sẽ nhận được 1 "Thâm Lam Tinh".\n3.Có thể phân giải nhiều Túi quà thần khí phụ, sau khi phân giải túi quà sẽ mất và nhận lại 1 lượng  "Thâm Lam Tinh", nếu chỉ phân giải 1 phần thì phải tách từ trong túi trước khi đem phân giải.';
            EQUIPTFUNCPANEL_S[92] = 'Hướng dẫn: \n1. Thần khí có độ bền nhất định (tương tự trang bị thông thường), khi độ bền giảm xuống còn 0 thì sức mạnh của thần khí sẽ mất, kỹ năng sẽ không còn dùng được nữa, cần phải sửa chữa. 2. Sửa chữa thần khí cần "Thâm Lam Tinh", mỗi lần sửa sẽ tốn 1 viên, sau khi sửa độ bền sẽ hồi phục tối đa.';
            EQUIPTFUNCPANEL_S[93] = 'Hướng dẫn: \n1. Chỉ có kỹ năng trưởng thành của thần khí chính mới có thể tái thiết lập lại. \n2. Tái thiết lập kỹ năng thần khí cần có "Thâm Hồng Tinh", mỗi lần tiêu hao 1 viên, sau đó chọn kỹ năng cần tái thiết lập trong danh mục sổ xuống. \n3. Sau khi tái thiết lập thì kỹ năng đã chọn sẽ mất, ngẫu nhiên nhận được 1 kỹ năng mới cấp 1.';
            EQUIPTFUNCPANEL_S[94] = "Xác nhận tái thiết lập kỹ năng thần khí: {skillName}?";
            EQUIPTFUNCPANEL_S[95] = "Sau khi chuyển thuộc tính thì thần khí bên trái sẽ mất, thần khí bên phải sẽ khóa, xác nhận tiến hành chuyển thuộc tính thần khí?";
            EQUIPTFUNCPANEL_S[96] = 'Hướng dẫn: \n1. Chỉ có thể tiến hành chuyển thuộc tính giữa những thần khí chính cùng loại, đồng thời chỉ cho phép thần khí mục tiêu có điểm thuộc tính thấp hơn. \n2. Chuyển thuộc tính thần khí cần 1 "Hoán Thần Thạch" và 1 lượng điểm thần tu nhất định. \n3. Sau khi chuyển thì thần khí gốc sẽ mất, thần khí mục tiêu nhận được 2 thuộc tính của thần khí gốc, các mục còn lại không đổi (cấp độ và kỹ năng của thần khí mục tiêu không đổi). \n4. "Hoán Thần Thạch" có thể nhận thông qua các sự kiện hàng ngày hoặc trong phụ bản.';
            EQUIPTFUNCPANEL_S[97] = "Mở/Đóng Túi nhanh";
