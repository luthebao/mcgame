            EQUIPTFUNCPANEL_S[35] = "Mua nguyên liệu";
            EQUIPTFUNCPANEL_S[36] = "Hướng dẫn: \n1. Thăng Tinh Thạch sẽ giúp thăng cấp sao cho trang bị, trang bị càng nhiều sao thì thuộc tính càng cao.\n2. Mỗi lần thăng tinh thì số nguyên liệu đặt vào sẽ không giống nhau.\n3. Tỷ lệ thành công khi thăng tinh sẽ phụ thuộc vào cấp độ sao hiện tại.\n4. Sau khi điền Số nguyên liệu và Sao thăng tối đa thì đặt vào đủ số lượng Thăng Tinh Thạch và nhấn nút Tự động thăng thì sẽ có thể tiến hành thăng cấp sao cho trang bị.";
            EQUIPTFUNCPANEL_S[37] = "Dùng Thăng Tinh Thạch khóa thì trang bị thăng cấp sao xong cũng sẽ khóa!";
            EQUIPTFUNCPANEL_S[38] = "Mua Thăng Tinh Thạch";
            EQUIPTFUNCPANEL_S[39] = "Hướng dẫn: \n1. Đặt trang bị cần khảm nạm vào ô trang bị, đặt các bảo thạch vào ô bảo thạch ở dưới rồi nhấn nút Khảm là được.\n2. Trang bị quái vật đánh rơi hay người chơi chế tạo đều có thể có ngẫu nhiên từ 1 - 4 lỗ. Bạn cũng có thể mua Kim cương để tiến hành đục thêm lỗ cho trang bị.\n3. Nhấp đôi vào bảo thạch trên trang bị để tháo gỡ, phí tháo gỡ bằng 20% giá trị (vàng hoặc kim phiếu) của bảo thạch.\n4. Mỗi khi khảm nạm 1 bảo thạch cấp 5 trên trang bị sẽ tăng thêm 1% HP cho nhân vật.\n5. Nếu khảm nạm bảo thạch đã khóa thì trang bị khảm nạm xong cũng sẽ khóa!";
            EQUIPTFUNCPANEL_S[40] = "Nếu khảm nạm bảo thạch đã khóa thì trang bị khảm nạm xong cũng sẽ khóa!";
            EQUIPTFUNCPANEL_S[41] = "Mua Bảo Thạch";
            EQUIPTFUNCPANEL_S[42] = "Hướng dẫn: \n1. Nguyên liệu rèn có chất lượng và tính chất khóa giống nhau thì có thể dung hợp thành nguyên liệu có phẩm chất cao hơn.\n2. Khi dung hợp thì số lượng nguyên liệu càng cao xác suất thành công sẽ càng cao. số lượng từ 2 đến 5.\n3. Xác suất thành công tối đa khi dung hợp nguyên liệu dưới cấp 6 là 100%, xác suất thành công khi dung hợp nguyên liệu cấp 6 là 30%.\n Nhấn Hợp để dung hợp 1 lần, nhấn Hợp tất cả để dung hợp tất cả nguyên liệu hiện có.";
            EQUIPTFUNCPANEL_S[43] = "Mua ng.liệu cao cấp";
            EQUIPTFUNCPANEL_S[44] = "Hướng dẫn: \n1. Bảo thạch có chất lượng và tính chất khóa giống nhau có thể thăng cấp thành bảo thạch cao cấp hơn (hiện tại cấp 5 là cao nhất).\n2. Khi dung hợp thì số lượng bảo thạch càng cao xác suất thành công sẽ càng cao. số lượng từ 2 đến 5.\nNhấn Thăng để dung hợp 1 lần, nhấn Thăng tất cả để dung hợp tất cả nguyên liệu hiện có.";
            EQUIPTFUNCPANEL_S[45] = "Mua Bảo Thạch";
            EQUIPTFUNCPANEL_S[46] = "Hướng dẫn: \n1. Trang bị do quái vật đánh rơi hoặc người chơi chế tạo đều có ngẫu nhiên từ 1 - 4 lỗ, bạn có thể đục thêm lỗ tại đây để khảm nạm thêm ngọc. Mỗi trang bị đã khóa có thể có tối đa 10 lỗ.\n2. Muốn đục lỗ trang bị cần phải có Kim cương tương ứng, xác suất thành công là 100% (Kim cương cấp 1 đục được 1 - 2 lỗ, cấp 2 được 3 - 4 lỗ, cấp 3 được 5 - 6 lỗ, cấp 4 được 7 - 8 lỗ, cấp 5 được 9 - 10 lỗ).";
            EQUIPTFUNCPANEL_S[47] = "Mua Kim Cương";
            EQUIPTFUNCPANEL_S[48] = "Hướng dẫn:\n1.Trang bị đã khóa phẩm chất <font color='#FF00FF'>tím</font> trở lên sau khi trả một lượng nguyên liệu và tiền vàng sẽ có thể đổi chất lượng trang bị tương ứng với nghề nghiệp. \n2.Khi sử dụng nguyên liệu cấp 4 để đổi trang bị: sẽ nhận được trang bị  <font color='#FF00FF'>tím</font>, các thuộc tính nguyên tố và khóa linh hồn sẽ được đổi ngẫu nhiên, trang bị sẽ bị hạ 1 cấp sao. Bảo thạch và số lỗ giữ nguyên. \n3.Khi dùng nguyên liệu cấp 5 để đổi trang bị: sẽ nhận được trang bị trác việt  <font color='#FF00FF'>tím</font>  (nếu trang bị đem đi đổi là <font color='#FA5B05'>cam</font> thì sẽ vẫn giữ được màu <font color='#FA5B05'>cam</font> và chất lượng), các thuộc tính nguyên tố và khóa linh hồn sẽ được đổi ngẫu nhiên, cấp sao không giảm, bảo thạch và số lỗ giữ nguyên \n4.Khi dùng nguyên liệu cấp 6 để đổi chất lượng:  sẽ nhận được trang bị <font color='#FA5B05'>cam</font> (nếu trang bị đem đổi là trác việt <font color='#FA5B05'>cam</font> thì sẽ vẫn giữ được màu <font color='#FA5B05'>cam</font> và chất lượng trác việt, còn nếu trang bị đem đi đổi là màu <font color='#FA5B05'>cam</font> nhưng không phải trác việt thì trang bị sẽ được đổi ngẫu nhiên, thuộc tính nguyên tố và khóa linh hồn sẽ được đổi ngẫu nhiên, cấp sao không giảm, bảo thạch và số lỗ giữ nguyên. ";
            EQUIPTFUNCPANEL_S[49] = "Mua ng.liệu cấp 4";
            EQUIPTFUNCPANEL_S[50] = "Hướng dẫn: \n1. Chuyển chữ ký trên trang bị thành tên của bạn, hoặc thêm tên bạn vào trang bị (chỉ thay đổi chữ ký, các thuộc tính khác giữ nguyên).\n2. Chỉ có trang bị tím trở lên đã khóa mới có thể đổi chữ ký, mỗi lần đổi chữ ký cần 1 nguyên liệu cấp 4 và 10000 bạc hoặc ngân phiếu.";
            EQUIPTFUNCPANEL_S[51] = "Hướng dẫn:\n1.Đổi thuộc tính nguyên tố của trang bị đã khóa, mỗi lần đổi thì thuộc tính sẽ thay đổi ngẫu nhiên (chỉ đổi nguyên tố, các thuộc tính khác giữ nguyên).\n2.Chỉ có trang bị đã khóa mới có thể đổi thuộc tính, mỗi lần đổi thuộc tính cần 1 nguyên liệu cấp 5 và 30000 bạc hoặc ngân phiếu.\n3Sau khi đổi nguyên tố có thể chủ động chọn ứng dụng hay hủy bỏ. Nếu ứng dụng thì tất cả thuộc tính nguyên tố đều trước đó đều sẽ được đổi.";
